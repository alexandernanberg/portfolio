{
  "name": "@alexandernanberg/portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "test": "echo \"Error: no test specified\" && exit 0",
    "lint": "oxlint --max-warnings=0 && oxfmt --check",
    "format": "oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@tailwindcss/vite": "4.3.3",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-config-alexandernanberg": "^1.2.1",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --max-warnings=0",
      "oxfmt --write"
    ],
    "*.{json,md,css}": [
      "oxfmt --write"
    ]
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Firefox versions"
  ],
  "packageManager": "pnpm@10.34.8"
}
